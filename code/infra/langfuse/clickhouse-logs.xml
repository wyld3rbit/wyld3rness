<!--
  ClickHouse's own internal logs, cut to what a local Langfuse needs.

  Why: ClickHouse ships with its sampling profiler and its internal logs on,
  with no expiry. On a laptop that runs Langfuse for weeks, system.trace_log
  (the profiler's samples) reached 14 GB and system.text_log 1.5 GB, and their
  background merges kept the VM at about 150% CPU with nothing else running.
  Langfuse never reads these tables; its own data lives in the default
  database and is untouched.

  What: the profiler's log and the noisiest internal logs are removed, so
  nothing writes or merges them. The query and part logs, useful when
  debugging ClickHouse, are kept for one day.

  Mounted read-only into /etc/clickhouse-server/config.d/ by docker-compose.yml.
-->
<clickhouse>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </part_log>
</clickhouse>
